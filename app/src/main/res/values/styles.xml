<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AudioSeeker" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.AudioSeeker.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_audioseeker</item>
        <item name="postSplashScreenTheme">@style/Theme.AudioSeeker</item>
    </style>
</resources>
